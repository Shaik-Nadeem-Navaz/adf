{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText5",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable9",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable11",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable10",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "join2"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          f_CustomerID as integer,",
				"          f_FirstName as string,",
				"          f_LastName as string,",
				"          f_Gender as string,",
				"          f_DateOfBirth as string,",
				"          f_AccountOpenDate as string,",
				"          f_MobileNumber as string,",
				"          f_Address as string,",
				"          f_Location as string,",
				"          f_EmailID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          DateOfBirth as date,",
				"          AccountOpenDate as date,",
				"          MobileNumber as string,",
				"          Address as string,",
				"          Location as string,",
				"          EmailID as string,",
				"          ModifiedDate as timestamp,",
				"          md5 as binary",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(f_ModifiedDate = currentUTC(),",
				"          f_IsActive = true(),",
				"          f_HashKey = toBinary(md5(f_MobileNumber,f_Address,f_Location,f_EmailID))) ~> derivedColumn1",
				"derivedColumn1, derivedColumn2 join(f_CustomerID == CustomerID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"source2 derive(IsActive1 = false()) ~> derivedColumn2",
				"derivedColumn2, join1 join(source2@CustomerID == f_CustomerID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 alterRow(updateIf(true())) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          DateOfBirth as date,",
				"          AccountOpenDate as date,",
				"          MobileNumber as string,",
				"          Address as string,",
				"          Location as string,",
				"          EmailID as string,",
				"          ModifiedDate as timestamp,",
				"          md5 as binary,",
				"          IsActive as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['IsActive'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          CustomerID = source2@CustomerID,",
				"          FirstName = source2@FirstName,",
				"          LastName = source2@LastName,",
				"          Gender = source2@Gender,",
				"          DateOfBirth = source2@DateOfBirth,",
				"          AccountOpenDate = source2@AccountOpenDate,",
				"          MobileNumber = source2@MobileNumber,",
				"          Address = source2@Address,",
				"          Location = source2@Location,",
				"          EmailID = source2@EmailID,",
				"          md5 = source2@md5,",
				"          IsActive = derivedColumn2@IsActive1",
				"     )) ~> sink1",
				"join1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          DateOfBirth as date,",
				"          AccountOpenDate as date,",
				"          MobileNumber as string,",
				"          Address as string,",
				"          Location as string,",
				"          EmailID as string,",
				"          ModifiedDate as timestamp,",
				"          md5 as binary,",
				"          IsActive as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          CustomerID = f_CustomerID,",
				"          FirstName = f_FirstName,",
				"          LastName = f_LastName,",
				"          Gender = f_Gender,",
				"          DateOfBirth = f_DateOfBirth,",
				"          AccountOpenDate = f_AccountOpenDate,",
				"          MobileNumber = f_MobileNumber,",
				"          Address = f_Address,",
				"          Location = f_Location,",
				"          EmailID = f_EmailID,",
				"          ModifiedDate = f_ModifiedDate,",
				"          md5 = f_HashKey,",
				"          IsActive = f_IsActive",
				"     )) ~> sink2"
			]
		}
	}
}