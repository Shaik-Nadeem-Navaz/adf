{
	"name": "df_SCDtype1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_SCD_PickingFile",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_SCDsinkTable",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "join1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          f_CustomerID as string 'int',",
				"          f_FirstName as string,",
				"          f_LastName as string,",
				"          f_Gender as string,",
				"          f_DateOfBirth as string 'date',",
				"          f_AccountOpenDate as string 'date',",
				"          f_MobileNumber as string,",
				"          f_Address as string,",
				"          f_Location as string,",
				"          f_EmailID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Gender as string,",
				"          DateOfBirth as date,",
				"          AccountOpenDate as date,",
				"          MobileNumber as string,",
				"          Address as string,",
				"          Location as string,",
				"          EmailID as string,",
				"          ModifiedDate as timestamp,",
				"          md5 as binary",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(f_HashKey = md5(f_MobileNumber,f_Address,f_Location,f_EmailID),",
				"          f_ModifiedDate = currentUTC()) ~> derivedColumn1",
				"derivedColumn1, source2 join(f_CustomerID == CustomerID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(ERROR_FUNCTION(''),",
				"     disjoint: false) ~> split1@(, )"
			]
		}
	}
}